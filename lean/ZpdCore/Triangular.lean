public import Mathlib.Algebra.Field.ZMod
public import Mathlib.Algebra.Ring.MinimalAxioms

/-!
# The triangular algebra and `cor:triangular`

This file formalises, for the paper "Algebras Determined by a Braided-Symmetric Product",

* Brešar's Theorem 2.15 (reference book, p. 49; the proof is Lemma 2.2, p. 18): a unital algebra
  over a field whose idempotents generate it is zero product determined
  (`ZpdCore.zpd_of_idempotents_generate`);
* the triangular algebra `Tri A₁ M A₂` of matrices `[[a, m], [0, b]]`, with its ring and
  `K`-algebra structure (`ZpdCore.Tri`), and the fact that it is generated by its idempotents
  when `A₁` and `A₂` are (`ZpdCore.Tri.closure_idempotents`, Brešar's Corollary 2.5);
* `cor:triangular`: `Tri A₁ M A₂` is zero product determined, hence determined by
  `μ (x, y) = f (x * y)` for every linear `f`, and by the twisted product
  `x * y + α y * α x` for every linear `α` with `α (x * y) = α y * α x`.

The generation hypothesis is stated as `Algebra.adjoin K {e | e * e = e} = ⊤`, generation as a
`K`-subalgebra.  The reference's phrase "generated by idempotents" can also be read as generation
as a ring; that reading is stronger and implies this one
(`ZpdCore.adjoin_eq_top_of_subring_closure_eq_top`), so the theorems below cover both.

The remaining hypotheses on the bimodule are those that make `Tri A₁ M A₂` a `K`-algebra at all:
`M` is a `K`-vector space (`Module K M`), an `A₁`-module and a right `A₂`-module
(`Module A₂ᵐᵒᵖ M`), the two actions commute (`SMulCommClass`), and each is `K`-linear
(`IsScalarTower K A₁ M`, `IsScalarTower K A₂ᵐᵒᵖ M`).  They are implicit in the reference's
"algebra over a field" setting.

No `sorry`, no added axiom; the `#print axioms` block at the end reports only Lean's standard
axioms.
-/

@[expose] public section

namespace ZpdCore

universe u

variable {K : Type u} [Field K] {A : Type u} [Ring A] [Algebra K A]

/-- The subring form of the hypothesis implies the `K`-subalgebra form: the subring generated by
the idempotents sits inside the `K`-subalgebra they generate.  So a theorem stated with
`Algebra.adjoin K` covers the reference's "generated by idempotents" under either reading. -/
theorem adjoin_eq_top_of_subring_closure_eq_top
    (h : Subring.closure {e : A | e * e = e} = ⊤) :
    Algebra.adjoin K {e : A | e * e = e} = ⊤ := by
  rw [eq_top_iff]
  intro x _
  have hx' : x ∈ Subring.closure {e : A | e * e = e} := by
    rw [h]
    exact Subring.mem_top x
  have hle : Subring.closure {e : A | e * e = e} ≤
      (Algebra.adjoin K {e : A | e * e = e}).toSubring :=
    Subring.closure_le.mpr (fun e he => Algebra.subset_adjoin he)
  exact hle hx'

/-- **Lemma 2.2 / Theorem 2.15.** Let `A` be a unital algebra over a field `K` and suppose that
the idempotents of `A` generate `A` as a `K`-algebra.  Then `A` is zero product determined.

The hypothesis is the weak reading of the reference's "generated by idempotents": generation as a
`K`-subalgebra (a `K`-linear span of products of idempotents).  Brešar's proof only needs the
subring generated, which is contained in the subalgebra generated, so this form covers both
readings. -/
theorem zpd_of_idempotents_generate (hgen : Algebra.adjoin K {e : A | e * e = e} = ⊤) :
    ZeroProductDetermined K A := by
  intro V _ _ φ hφ
  -- the `K`-subalgebra `R₀` of all `r` that can be moved from the left to the right factor of `φ`
  let R : Subalgebra K A :=
    { carrier := {r : A | ∀ x z : A, φ (x * r) z = φ x (r * z)}
      mul_mem' := by
        intro r s hr hs x z
        show φ (x * (r * s)) z = φ x (r * s * z)
        rw [← mul_assoc x r s, hs (x * r) z, hr x (s * z), mul_assoc]
      one_mem' := by
        intro x z
        show φ (x * 1) z = φ x (1 * z)
        rw [mul_one, one_mul]
      add_mem' := by
        intro r s hr hs x z
        show φ (x * (r + s)) z = φ x ((r + s) * z)
        rw [mul_add, add_mul, map_add, LinearMap.add_apply, LinearMap.map_add, hr x z, hs x z]
      zero_mem' := by
        intro x z
        show φ (x * 0) z = φ x (0 * z)
        rw [mul_zero, zero_mul, map_zero, LinearMap.zero_apply, LinearMap.map_zero]
      algebraMap_mem' := by
        intro k x z
        show φ (x * algebraMap K A k) z = φ x (algebraMap K A k * z)
        rw [← Algebra.commutes k x, ← Algebra.smul_def k x, ← Algebra.smul_def k z,
          LinearMap.map_smul, LinearMap.smul_apply, LinearMap.map_smul] }
  -- every idempotent lies in `R`
  have hidem : ∀ e : A, e * e = e → e ∈ R := by
    intro e he x z
    show φ (x * e) z = φ x (e * z)
    have key : ∀ a b : A, (a * e) * (e * b) = a * (e * b) := by
      intro a b
      rw [← mul_assoc (a * e) e b, mul_assoc a e e, he, mul_assoc a e b]
    have h1 : (x * e) * (z - e * z) = 0 := by
      rw [mul_sub, key x z, mul_assoc x e z, sub_self]
    have h2 : (x - x * e) * (e * z) = 0 := by
      rw [sub_mul, key x z, sub_self]
    have hz1 : φ (x * e) (z - e * z) = 0 := hφ _ _ h1
    have hz2 : φ (x - x * e) (e * z) = 0 := hφ _ _ h2
    calc φ (x * e) z
        = φ (x * e) (e * z + (z - e * z)) := by rw [add_sub_cancel]
      _ = φ (x * e) (e * z) + φ (x * e) (z - e * z) := by rw [map_add]
      _ = φ (x * e) (e * z) := by rw [hz1, add_zero]
      _ = φ (x - x * e) (e * z) + φ (x * e) (e * z) := by rw [hz2, zero_add]
      _ = φ ((x - x * e) + x * e) (e * z) := by rw [map_add, LinearMap.add_apply]
      _ = φ x (e * z) := by rw [sub_add_cancel]
  have htop : R = ⊤ := by
    rw [eq_top_iff, ← hgen]
    exact Algebra.adjoin_le_iff.mpr (fun e he => hidem e he)
  refine ⟨φ 1, fun x y => ?_⟩
  have hx : x ∈ R := by
    rw [htop]
    simp
  simpa using hx 1 y

end ZpdCore

namespace ZpdCore

universe u

/-- The algebra of matrices `[[a, m], [0, b]]` with `a : A₁`, `m : M`, `b : A₂`. -/
structure Tri (A₁ M A₂ : Type u) where
  /-- the upper left entry -/
  fst : A₁
  /-- the upper right entry -/
  snd : M
  /-- the lower right entry -/
  thd : A₂

namespace Tri

/-- Two elements of the triangular algebra are equal as soon as their three entries are. -/
@[ext]
theorem ext {x y : Tri A₁ M A₂} (h1 : x.fst = y.fst) (h2 : x.snd = y.snd)
    (h3 : x.thd = y.thd) : x = y := by
  obtain ⟨a, m, b⟩ := x
  obtain ⟨a', m', b'⟩ := y
  simp_all

variable {A₁ M A₂ : Type u}

section Add

variable [Add A₁] [Add M] [Add A₂]

instance : Add (Tri A₁ M A₂) :=
  ⟨fun x y => ⟨x.fst + y.fst, x.snd + y.snd, x.thd + y.thd⟩⟩

@[simp] theorem fst_add (x y : Tri A₁ M A₂) : (x + y).fst = x.fst + y.fst := rfl
@[simp] theorem snd_add (x y : Tri A₁ M A₂) : (x + y).snd = x.snd + y.snd := rfl
@[simp] theorem thd_add (x y : Tri A₁ M A₂) : (x + y).thd = x.thd + y.thd := rfl

end Add

section Zero

variable [Zero A₁] [Zero M] [Zero A₂]

instance : Zero (Tri A₁ M A₂) := ⟨⟨0, 0, 0⟩⟩

@[simp] theorem fst_zero : (0 : Tri A₁ M A₂).fst = 0 := rfl
@[simp] theorem snd_zero : (0 : Tri A₁ M A₂).snd = 0 := rfl
@[simp] theorem thd_zero : (0 : Tri A₁ M A₂).thd = 0 := rfl

end Zero

section Neg

variable [Neg A₁] [Neg M] [Neg A₂]

instance : Neg (Tri A₁ M A₂) := ⟨fun x => ⟨-x.fst, -x.snd, -x.thd⟩⟩

@[simp] theorem fst_neg (x : Tri A₁ M A₂) : (-x).fst = -x.fst := rfl
@[simp] theorem snd_neg (x : Tri A₁ M A₂) : (-x).snd = -x.snd := rfl
@[simp] theorem thd_neg (x : Tri A₁ M A₂) : (-x).thd = -x.thd := rfl

end Neg

section One

variable [One A₁] [Zero M] [One A₂]

instance : One (Tri A₁ M A₂) := ⟨⟨1, 0, 1⟩⟩

@[simp] theorem fst_one : (1 : Tri A₁ M A₂).fst = 1 := rfl
@[simp] theorem snd_one : (1 : Tri A₁ M A₂).snd = 0 := rfl
@[simp] theorem thd_one : (1 : Tri A₁ M A₂).thd = 1 := rfl

/-- The unit of the triangular algebra is `[[1, 0], [0, 1]]`. -/
theorem one_def : (1 : Tri A₁ M A₂) = ⟨1, 0, 1⟩ := rfl

end One

section Mul

variable [Mul A₁] [Add M] [SMul A₁ M] [SMul A₂ᵐᵒᵖ M] [Mul A₂]

instance : Mul (Tri A₁ M A₂) :=
  ⟨fun x y =>
    ⟨x.fst * y.fst, x.fst • y.snd + (MulOpposite.op y.thd) • x.snd, x.thd * y.thd⟩⟩

@[simp] theorem fst_mul (x y : Tri A₁ M A₂) : (x * y).fst = x.fst * y.fst := rfl
@[simp] theorem snd_mul (x y : Tri A₁ M A₂) :
    (x * y).snd = x.fst • y.snd + (MulOpposite.op y.thd) • x.snd := rfl
@[simp] theorem thd_mul (x y : Tri A₁ M A₂) : (x * y).thd = x.thd * y.thd := rfl

/-- The product of `[[a, m], [0, b]]` and `[[a', m'], [0, b']]` is
`[[a * a', a • m' + m <• b'], [0, b * b']]`. -/
theorem mul_def (x y : Tri A₁ M A₂) :
    x * y = ⟨x.fst * y.fst, x.fst • y.snd + (MulOpposite.op y.thd) • x.snd, x.thd * y.thd⟩ :=
  rfl

end Mul

section Ring

variable [Ring A₁] [AddCommGroup M] [Ring A₂]
variable [Module A₁ M] [Module A₂ᵐᵒᵖ M] [SMulCommClass A₁ A₂ᵐᵒᵖ M]

-- The ring structure of the triangular algebra.  One `simp` set with the componentwise lemmas
-- closes every axiom, so the unused-argument linter is off for this definition only.
set_option linter.unusedSimpArgs false in
instance : Ring (Tri A₁ M A₂) :=
  Ring.ofMinimalAxioms
    (fun a b c => by ext <;> simp [add_assoc])
    (fun a => by ext <;> simp)
    (fun a => by ext <;> simp)
    (fun a b c => by
      ext <;> (simp only [fst_mul, snd_mul, thd_mul, fst_add, snd_add, thd_add, fst_zero,
        snd_zero, thd_zero, mul_add, add_mul, smul_add, add_smul, mul_smul, smul_comm, mul_assoc,
        smul_zero, zero_smul, MulOpposite.op_mul, MulOpposite.op_add, MulOpposite.op_zero,
        MulOpposite.op_one] <;> try abel))
    (fun a => by ext <;> simp)
    (fun a => by ext <;> simp)
    (fun a b c => by
      ext <;> (simp only [fst_mul, snd_mul, thd_mul, fst_add, snd_add, thd_add, fst_zero,
        snd_zero, thd_zero, mul_add, add_mul, smul_add, add_smul, mul_smul, smul_comm, mul_assoc,
        smul_zero, zero_smul, MulOpposite.op_mul, MulOpposite.op_add, MulOpposite.op_zero,
        MulOpposite.op_one] <;> try abel))
    (fun a b c => by
      ext <;> (simp only [fst_mul, snd_mul, thd_mul, fst_add, snd_add, thd_add, fst_zero,
        snd_zero, thd_zero, mul_add, add_mul, smul_add, add_smul, mul_smul, smul_comm, mul_assoc,
        smul_zero, zero_smul, MulOpposite.op_mul, MulOpposite.op_add, MulOpposite.op_zero,
        MulOpposite.op_one] <;> try abel))

end Ring

section Algebra

variable {K : Type u} [Field K]
variable [Ring A₁] [Algebra K A₁] [AddCommGroup M] [Module K M]
variable [Module A₁ M] [IsScalarTower K A₁ M]
variable [Ring A₂] [Algebra K A₂] [Module A₂ᵐᵒᵖ M] [IsScalarTower K A₂ᵐᵒᵖ M]
variable [SMulCommClass A₁ A₂ᵐᵒᵖ M]

/-- The left action of `A₁` agrees with the `K`-action. -/
theorem algebraMap_smul (k : K) (m : M) : algebraMap K A₁ k • m = k • m := by
  rw [Algebra.algebraMap_eq_smul_one, smul_assoc, one_smul]

/-- The right action of `A₂` (left action of `A₂ᵐᵒᵖ`) agrees with the `K`-action. -/
theorem op_algebraMap_smul (k : K) (m : M) :
    (MulOpposite.op (algebraMap K A₂ k)) • m = k • m := by
  rw [Algebra.algebraMap_eq_smul_one, MulOpposite.op_smul, MulOpposite.op_one, smul_assoc,
    one_smul]

instance : SMul K (Tri A₁ M A₂) := ⟨fun k x => ⟨k • x.fst, k • x.snd, k • x.thd⟩⟩

omit [Module A₁ M] [IsScalarTower K A₁ M] [Module A₂ᵐᵒᵖ M] [IsScalarTower K A₂ᵐᵒᵖ M]
  [SMulCommClass A₁ A₂ᵐᵒᵖ M] in
@[simp] theorem fst_smul (k : K) (x : Tri A₁ M A₂) : (k • x).fst = k • x.fst := rfl

omit [Module A₁ M] [IsScalarTower K A₁ M] [Module A₂ᵐᵒᵖ M] [IsScalarTower K A₂ᵐᵒᵖ M]
  [SMulCommClass A₁ A₂ᵐᵒᵖ M] in
@[simp] theorem snd_smul (k : K) (x : Tri A₁ M A₂) : (k • x).snd = k • x.snd := rfl

omit [Module A₁ M] [IsScalarTower K A₁ M] [Module A₂ᵐᵒᵖ M] [IsScalarTower K A₂ᵐᵒᵖ M]
  [SMulCommClass A₁ A₂ᵐᵒᵖ M] in
@[simp] theorem thd_smul (k : K) (x : Tri A₁ M A₂) : (k • x).thd = k • x.thd := rfl

instance : Algebra K (Tri A₁ M A₂) where
  toSMul := inferInstance
  algebraMap :=
    { toFun := fun k => ⟨algebraMap K A₁ k, 0, algebraMap K A₂ k⟩
      map_one' := by ext <;> simp
      map_mul' := by intro k l; ext <;> simp
      map_zero' := by ext <;> simp
      map_add' := by intro k l; ext <;> simp }
  commutes' := by
    intro k x
    ext
    · exact Algebra.commutes k x.fst
    · show algebraMap K A₁ k • x.snd + (MulOpposite.op x.thd) • (0 : M)
          = x.fst • (0 : M) + (MulOpposite.op (algebraMap K A₂ k)) • x.snd
      rw [algebraMap_smul, op_algebraMap_smul, smul_zero, smul_zero, add_zero, zero_add]
    · exact Algebra.commutes k x.thd
  smul_def' := by
    intro k x
    ext
    · exact Algebra.smul_def k x.fst
    · show k • x.snd
          = algebraMap K A₁ k • x.snd + (MulOpposite.op x.thd) • (0 : M)
      rw [algebraMap_smul, smul_zero, add_zero]
    · exact Algebra.smul_def k x.thd

@[simp] theorem algebraMap_fst (k : K) :
    (algebraMap K (Tri A₁ M A₂) k).fst = algebraMap K A₁ k := rfl
@[simp] theorem algebraMap_snd (k : K) : (algebraMap K (Tri A₁ M A₂) k).snd = 0 := rfl
@[simp] theorem algebraMap_thd (k : K) :
    (algebraMap K (Tri A₁ M A₂) k).thd = algebraMap K A₂ k := rfl

end Algebra

end Tri

end ZpdCore

namespace ZpdCore

universe u

namespace Tri

variable {K : Type u} [Field K]
variable {A₁ : Type u} [Ring A₁] [Algebra K A₁] [AddCommGroup M] [Module K M]
variable [Module A₁ M] [IsScalarTower K A₁ M]
variable {A₂ : Type u} [Ring A₂] [Algebra K A₂] [Module A₂ᵐᵒᵖ M]
variable [IsScalarTower K A₂ᵐᵒᵖ M]
variable [SMulCommClass A₁ A₂ᵐᵒᵖ M]

/-- The idempotents of the triangular algebra generate it as a `K`-algebra, when those of `A₁` and
of `A₂` do: `⟨a, 0, 0⟩` and `⟨0, 0, b⟩` are images of algebra elements, and
`⟨0, m, 0⟩ = ⟨1, m, 0⟩ - ⟨1, 0, 0⟩` is a difference of two idempotents. -/
theorem closure_idempotents (h₁ : Algebra.adjoin K {e : A₁ | e * e = e} = ⊤)
    (h₂ : Algebra.adjoin K {e : A₂ | e * e = e} = ⊤) :
    Algebra.adjoin K {e : Tri A₁ M A₂ | e * e = e} = ⊤ := by
  set S : Subalgebra K (Tri A₁ M A₂) :=
    Algebra.adjoin K {e : Tri A₁ M A₂ | e * e = e} with hS
  have key₁ : ∀ a : A₁, (⟨a, 0, 0⟩ : Tri A₁ M A₂) ∈ S := by
    intro a
    have ha : a ∈ Algebra.adjoin K {e : A₁ | e * e = e} := by rw [h₁]; simp
    induction ha using Algebra.adjoin_induction with
    | mem x hx =>
        exact Algebra.subset_adjoin (s := {e : Tri A₁ M A₂ | e * e = e}) (by
          have hx' : x * x = x := hx
          ext <;> simp [hx'])
    | add x y _ _ hx hy =>
        have hxy : (⟨x + y, 0, 0⟩ : Tri A₁ M A₂) = ⟨x, 0, 0⟩ + ⟨y, 0, 0⟩ := by ext <;> simp
        rw [hxy]
        exact S.add_mem hx hy
    | mul x y _ _ hx hy =>
        have hxy : (⟨x * y, 0, 0⟩ : Tri A₁ M A₂) = ⟨x, 0, 0⟩ * ⟨y, 0, 0⟩ := by ext <;> simp
        rw [hxy]
        exact S.mul_mem hx hy
    | algebraMap k =>
        have h1 : (⟨(1 : A₁), 0, 0⟩ : Tri A₁ M A₂) ∈ S :=
          Algebra.subset_adjoin (s := {e : Tri A₁ M A₂ | e * e = e}) (by ext <;> simp)
        have hk : (⟨algebraMap K A₁ k, 0, 0⟩ : Tri A₁ M A₂) = k • ⟨(1 : A₁), 0, 0⟩ := by
          rw [Algebra.algebraMap_eq_smul_one]
          ext <;> simp
        rw [hk]
        exact S.smul_mem h1 k
  have key₂ : ∀ b : A₂, (⟨0, 0, b⟩ : Tri A₁ M A₂) ∈ S := by
    intro b
    have hb : b ∈ Algebra.adjoin K {e : A₂ | e * e = e} := by rw [h₂]; simp
    induction hb using Algebra.adjoin_induction with
    | mem x hx =>
        exact Algebra.subset_adjoin (s := {e : Tri A₁ M A₂ | e * e = e}) (by
          have hx' : x * x = x := hx
          ext <;> simp [hx'])
    | add x y _ _ hx hy =>
        have hxy : (⟨0, 0, x + y⟩ : Tri A₁ M A₂) = ⟨0, 0, x⟩ + ⟨0, 0, y⟩ := by ext <;> simp
        rw [hxy]
        exact S.add_mem hx hy
    | mul x y _ _ hx hy =>
        have hxy : (⟨0, 0, x * y⟩ : Tri A₁ M A₂) = ⟨0, 0, x⟩ * ⟨0, 0, y⟩ := by ext <;> simp
        rw [hxy]
        exact S.mul_mem hx hy
    | algebraMap k =>
        have h1 : (⟨0, 0, (1 : A₂)⟩ : Tri A₁ M A₂) ∈ S :=
          Algebra.subset_adjoin (s := {e : Tri A₁ M A₂ | e * e = e}) (by ext <;> simp)
        have hk : (⟨0, 0, algebraMap K A₂ k⟩ : Tri A₁ M A₂) = k • ⟨0, 0, (1 : A₂)⟩ := by
          rw [Algebra.algebraMap_eq_smul_one]
          ext <;> simp
        rw [hk]
        exact S.smul_mem h1 k
  have keym : ∀ m : M, (⟨0, m, 0⟩ : Tri A₁ M A₂) ∈ S := by
    intro m
    have e₁ : (⟨1, m, 0⟩ : Tri A₁ M A₂) ∈ S :=
      Algebra.subset_adjoin (s := {e : Tri A₁ M A₂ | e * e = e}) (by ext <;> simp)
    have e₀ : (⟨1, 0, 0⟩ : Tri A₁ M A₂) ∈ S :=
      Algebra.subset_adjoin (s := {e : Tri A₁ M A₂ | e * e = e}) (by ext <;> simp)
    have h := S.sub_mem e₁ e₀
    have hgoal : (⟨1, m, 0⟩ - ⟨1, 0, 0⟩ : Tri A₁ M A₂) = ⟨0, m, 0⟩ := by
      ext <;> simp [sub_eq_add_neg]
    rw [hgoal] at h
    exact h
  rw [eq_top_iff]
  intro x _
  obtain ⟨a, m, b⟩ := x
  have h := S.add_mem (S.add_mem (key₁ a) (keym m)) (key₂ b)
  have hx : (⟨a, m, b⟩ : Tri A₁ M A₂)
      = (⟨a, 0, 0⟩ + ⟨0, m, 0⟩) + ⟨0, 0, b⟩ := by
    ext <;> simp
  rw [hx]
  exact h

/-- **`cor:bresar-matrix`**(b): `Tri(A₁, M, A₂)` is zero product determined, when `A₁` and
`A₂` are unital algebras generated by their idempotents and `M` is a unital bimodule. -/
theorem zeroProductDetermined (h₁ : Algebra.adjoin K {e : A₁ | e * e = e} = ⊤)
    (h₂ : Algebra.adjoin K {e : A₂ | e * e = e} = ⊤) :
    ZeroProductDetermined K (Tri A₁ M A₂) :=
  zpd_of_idempotents_generate (K := K) (A := Tri A₁ M A₂) (closure_idempotents h₁ h₂)

/-- **`cor:triangular`**, first part: for every `K`-linear `f : A → A`, the triangular algebra
`A = Tri(A₁, M, A₂)` is determined by `μ(x, y) = f (x * y)`. -/
theorem determined_comp_mul (h₁ : Algebra.adjoin K {e : A₁ | e * e = e} = ⊤)
    (h₂ : Algebra.adjoin K {e : A₂ | e * e = e} = ⊤)
    (f : Tri A₁ M A₂ →ₗ[K] Tri A₁ M A₂) :
    Determined (compMu (LinearMap.mul K (Tri A₁ M A₂)) f) :=
  determined_comp_of_right_id _ (zeroProductDetermined h₁ h₂) f 1 (fun b => mul_one b)

/-- **`cor:triangular`**, second part: for every `K`-linear `α` with `α (x * y) = α y * α x`,
`A = Tri(A₁, M, A₂)` is determined by the twisted product `x * y + α y * α x`. -/
theorem determined_twist (h₁ : Algebra.adjoin K {e : A₁ | e * e = e} = ⊤)
    (h₂ : Algebra.adjoin K {e : A₂ | e * e = e} = ⊤)
    (α : Tri A₁ M A₂ →ₗ[K] Tri A₁ M A₂)
    (hα : ∀ x y : Tri A₁ M A₂, α (x * y) = α y * α x) :
    Determined (twistMu α) :=
  anti_twisted_determined (zeroProductDetermined h₁ h₂) α hα

end Tri

/-! ## A non-vacuity check: the upper triangular `2 × 2` matrices over `ZMod 2` -/

/-- The idempotents of `ZMod 2` generate it as a `ZMod 2`-algebra. -/
theorem zmod2_adjoin_idempotents :
    Algebra.adjoin (ZMod 2) {e : ZMod 2 | e * e = e} = ⊤ := by
  rw [eq_top_iff]
  intro x _
  have h1 : (1 : ZMod 2) ∈ Algebra.adjoin (ZMod 2) {e : ZMod 2 | e * e = e} :=
    Algebra.subset_adjoin (by decide)
  have h0 : (0 : ZMod 2) ∈ Algebra.adjoin (ZMod 2) {e : ZMod 2 | e * e = e} :=
    (Algebra.adjoin (ZMod 2) {e : ZMod 2 | e * e = e}).zero_mem
  fin_cases x
  · exact h0
  · exact h1

/-- `Tri (ZMod 2) (ZMod 2) (ZMod 2)`, the upper triangular `2 × 2` matrices over `ZMod 2`, is
zero product determined: the hypotheses of `cor:triangular` are not vacuous. -/
theorem zmod2_tri_zpd : ZeroProductDetermined (ZMod 2) (Tri (ZMod 2) (ZMod 2) (ZMod 2)) :=
  Tri.zeroProductDetermined (K := ZMod 2) zmod2_adjoin_idempotents zmod2_adjoin_idempotents

end ZpdCore

