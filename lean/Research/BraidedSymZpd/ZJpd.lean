@[expose] public section

/-!
# Algebras generated by idempotents are zero Jordan product determined

Bresar's Theorem 3.15, which is what the paper's `rem:inner` uses: if `A` is a unital algebra over
a field `K` with `2 ≠ 0` that is **generated** by its idempotents, then `A` is zero Jordan product
determined, i.e. `Determined (twistMu LinearMap.id)`, where `twistMu id x y = x * y + y * x`.

An-Li-He's Theorem 2.1 (`Zero Jordan product determined algebras`, LAA 475 (2015), 90-93) is this
same generated-subalgebra statement; their own restatement of it is An-Li, `Characterizations of
linear mappings through zero products or zero Jordan products`, ELA 31 (2016), Lemma 4.1: every
`phi` vanishing on the anticommuting pairs satisfies `phi (a, x) = phi (a * x, 1) / 2 +
phi (x * a, 1) / 2` "for every `a` in `A` and every `x` in `J(A)`", where `J(A)` is the subalgebra
generated by the idempotents. The same conclusion under the stronger hypothesis that the
idempotents **span** `A` linearly is Ghahramani's Theorem 3.3 (`On derivations and Jordan
derivations through zero products`, Oper. Matrices 8 (2014), 759-771), proved there over `ℂ`; it
is kept below as `determined_twistMu_id`, where only `2 ≠ 0` is used.

The proof is the Peirce computation plus Bresar's induction on products of idempotents. For a
bilinear `phi` vanishing on the pairs with `x * y + y * x = 0`, an idempotent `e`, `f = 1 - e` and
arbitrary `a`, the Peirce pieces `a1 = e a e`, `u = e a f`, `v = f a e`, `a0 = f a f` satisfy the
zero-product pairs `(a1, f)`, `(a0, e)`, `(u, 1 - 2e)`, `(v, 1 - 2e)`, which gives
`2 * phi a e = phi (a * e) 1 + phi (e * a) 1`. That is the membership of a single idempotent in
Bresar's set `S` of (3.20); the induction step then shows that `e1 * t * e2 ∈ S` whenever
`t * e2`, `(1 - e1) * t` and `e1 * t` are in `S`, by splitting `x` into its four Peirce pieces with
respect to `e1` on the right and `e2` on the left. Since `S` is a linear subspace and the products
of idempotents span a subalgebra, `S` contains the subalgebra generated by the idempotents.

## The two hypotheses are not equivalent

Generation is genuinely weaker than linear spanning, so the theorem below is not a corollary of
`determined_twistMu_id` and cannot be replaced by it. Take `A = M_n(K[eps])` with `eps^2 = 0`,
`n ≥ 2`, over a field of characteristic `≠ 2`. Writing an element as `X + eps * Y` with matrices
`X`, `Y`, it is idempotent iff `X * X = X` and `X * Y + Y * X = Y`; in the Peirce
decomposition with respect to the idempotent `X` the second equation gives
`X Y X = (1 - X) Y (1 - X)`, and both sides are then `0`, so `Y` is off-diagonal (both of its
Peirce pieces `X Y X` and `(1 - X) Y (1 - X)` vanish) and `trace Y = 0`. Hence the linear
functional `ν (X + eps * Y) = trace Y` annihilates every idempotent, so it annihilates their
span, while `ν (eps * e_11) = 1 ≠ 0` in every characteristic:
the idempotents of `M_n(K[eps])` span at most a hyperplane, for every `n ≥ 2`. On the other hand
`M_n(B)` is generated by the idempotents `e_ii` and `e_ii + b e_ij` for every unital `B` and
`n ≥ 2`, which is the example `rem:inner` uses.

## Main results

* `ZJpd.two_smul_phi_apply_of_idem`: the Peirce identity for one idempotent, i.e. `e ∈ S`.
* `ZJpd.balancedSet_mul_idem`: Bresar's induction step for `S`.
* `ZJpd.prod_mem_balancedSet`: every product of idempotents lies in `S`.
* `ZJpd.adjoin_subset_balancedSet`: so does the subalgebra they generate.
* `ZJpd.determined_twistMu_of_generated`: `Determined (twistMu LinearMap.id)` when the idempotents
  generate `A` — Bresar's Theorem 3.15, the hypothesis of the paper's `rem:inner`.
* `ZJpd.two_smul_phi_apply` and `ZJpd.determined_twistMu_id`: the spanning hypothesis instead
  (An-Li-He's form), the second now a corollary of the generation theorem.
* `ZJpd.determined_twistMu_conjByUnit`: `Determined (twistMu (conjByUnit D))` for every unit `D` of
  `M2(K)` (`section Matrix2`), by `BraidedSymZpd.determined_twist_conj_iff` (the paper's
  `rem:inner`).
* `ZJpd.span_idempotents_matrix` and `ZJpd.determined_matrix2`: the case `M2(K)`, hence
  `prop:matrix` for `K = ZMod 3` and the conjugation by `diag (1, -1)`, with no enumeration.
-/

open TensorProduct

open scoped TensorProduct

open ZpdCore

namespace ZJpd

universe u

section Core

variable {K : Type u} [Field K]
variable {A : Type u} [Ring A] [Algebra K A]
variable {V : Type u} [AddCommGroup V] [Module K V]

/-- The Peirce computation for a single idempotent: a bilinear map vanishing on Jordan-zero pairs
is `1`-balanced at every idempotent. -/
theorem two_smul_phi_apply_of_idem {φ : A →ₗ[K] A →ₗ[K] V}
    (hφ : ∀ x y : A, x * y + y * x = 0 → φ x y = 0) {e : A} (he : e * e = e) (a : A) :
    (2 : K) • φ a e = φ (a * e) 1 + φ (e * a) 1 := by
  set f : A := 1 - e with hf
  have hfe : f * e = 0 := by rw [hf, sub_mul, one_mul, he, sub_self]
  have hef : e * f = 0 := by rw [hf, mul_sub, mul_one, he, sub_self]
  have he1 : e + f = 1 := by rw [hf, add_sub_cancel]
  set a1 : A := e * a * e with ha1
  set u : A := e * a * f with hu
  set v : A := f * a * e with hv
  set a0 : A := f * a * f with ha0
  have hdec : a = a1 + u + v + a0 := by
    simp only [ha1, hu, hv, ha0, hf]
    noncomm_ring
  have hae : a * e = a1 + v := by
    simp only [ha1, hv]
    rw [← add_mul, ← add_mul, he1, one_mul]
  have hea : e * a = a1 + u := by
    simp only [ha1, hu]
    rw [← mul_add, he1, mul_one]
  have h1 : a1 * f + f * a1 = 0 := by
    have hl : a1 * f = 0 := by
      simp only [ha1]
      rw [mul_assoc (e * a) e f, hef, mul_zero]
    have hr : f * a1 = 0 := by
      simp only [ha1]
      rw [← mul_assoc f (e * a) e, ← mul_assoc f e a, hfe, zero_mul, zero_mul]
    rw [hl, hr, add_zero]
  have h0 : a0 * e + e * a0 = 0 := by
    have hl : a0 * e = 0 := by
      simp only [ha0]
      rw [mul_assoc (f * a) f e, hfe, mul_zero]
    have hr : e * a0 = 0 := by
      simp only [ha0]
      rw [← mul_assoc e (f * a) f, ← mul_assoc e f a, hef, zero_mul, zero_mul]
    rw [hl, hr, add_zero]
  have hue : u * e = 0 := by
    simp only [hu]
    rw [mul_assoc (e * a) f e, hfe, mul_zero]
  have heu : e * u = u := by
    simp only [hu]
    rw [mul_assoc e a f, ← mul_assoc e e (a * f), he, ← mul_assoc e a f]
  have hve : v * e = v := by
    simp only [hv]
    rw [mul_assoc (f * a) e e, he]
  have hev : e * v = 0 := by
    simp only [hv]
    rw [mul_assoc f a e, ← mul_assoc e f (a * e), hef, zero_mul]
  have hu2 : u * (2 * e) = 0 := by
    rw [two_mul, mul_add, hue, add_zero]
  have h2eu : (2 * e) * u = u + u := by
    rw [two_mul, add_mul, heu]
  have hu' : u * (1 - 2 * e) + (1 - 2 * e) * u = 0 := by
    rw [mul_sub, mul_one, hu2, sub_zero, sub_mul, one_mul, h2eu]
    abel
  have hv2 : v * (2 * e) = v + v := by
    rw [two_mul, mul_add, hve]
  have h2ev : (2 * e) * v = 0 := by
    rw [two_mul, add_mul, hev, add_zero]
  have hv' : v * (1 - 2 * e) + (1 - 2 * e) * v = 0 := by
    rw [mul_sub, mul_one, hv2, sub_mul, one_mul, h2ev]
    abel
  have h2A : (2 : A) * e = (2 : K) • e := by rw [two_mul, two_smul]
  have z1 : φ a1 1 = φ a1 e := by
    have h := hφ a1 f h1
    rw [hf, map_sub, sub_eq_zero] at h
    exact h
  have z0 : φ a0 e = 0 := hφ a0 e h0
  have zu : (2 : K) • φ u e = φ u 1 := by
    have h := hφ u (1 - 2 * e) hu'
    rw [map_sub, h2A, map_smul, sub_eq_zero] at h
    exact h.symm
  have zv : (2 : K) • φ v e = φ v 1 := by
    have h := hφ v (1 - 2 * e) hv'
    rw [map_sub, h2A, map_smul, sub_eq_zero] at h
    exact h.symm
  have hz1 : (2 : K) • φ a1 e = φ a1 1 + φ a1 1 := by rw [two_smul, z1]
  have hz0 : (2 : K) • φ a0 e = 0 := by rw [z0, smul_zero]
  calc (2 : K) • φ a e
      = (2 : K) • φ (a1 + u + v + a0) e := by rw [hdec]
    _ = (2 : K) • (φ a1 e + φ u e + φ v e + φ a0 e) := by simp
    _ = (2 : K) • φ a1 e + (2 : K) • φ u e + (2 : K) • φ v e + (2 : K) • φ a0 e := by
        rw [smul_add, smul_add, smul_add]
    _ = (φ a1 1 + φ a1 1) + φ u 1 + φ v 1 + 0 := by rw [hz1, zu, zv, hz0]
    _ = φ (a * e) 1 + φ (e * a) 1 := by
        rw [hae, hea]
        simp only [map_add, LinearMap.add_apply]
        abel

/-- The Peirce identity for every element of the linear span of the idempotents. -/
theorem two_smul_phi_apply {φ : A →ₗ[K] A →ₗ[K] V}
    (hφ : ∀ x y : A, x * y + y * x = 0 → φ x y = 0) {b : A}
    (hb : b ∈ Submodule.span K {e : A | e * e = e}) (a : A) :
    (2 : K) • φ a b = φ (a * b) 1 + φ (b * a) 1 := by
  induction hb using Submodule.span_induction with
  | mem e he => exact two_smul_phi_apply_of_idem hφ he a
  | zero => simp
  | add x y _ _ ihx ihy =>
      rw [map_add, smul_add, ihx, ihy, mul_add, add_mul]
      simp only [map_add, LinearMap.add_apply]
      abel
  | smul c x _ ih =>
      rw [LinearMap.map_smul, smul_comm (2 : K) c, ih, smul_add, Algebra.smul_mul_assoc,
        map_smul, LinearMap.smul_apply, Algebra.mul_smul_comm, map_smul, LinearMap.smul_apply]

/-- Bresar's set `S` of (3.20): the elements at which `phi` is `1`-balanced. -/
noncomputable def balancedSet {V : Type u} [AddCommGroup V] [Module K V]
    (φ : A →ₗ[K] A →ₗ[K] V) : Submodule K A where
  carrier := {s : A | ∀ x : A, (2 : K) • φ x s = φ (x * s + s * x) 1}
  zero_mem' := by
    intro x
    simp
  add_mem' := by
    intro a b ha hb x
    have h : x * (a + b) + (a + b) * x = (x * a + a * x) + (x * b + b * x) := by
      noncomm_ring
    rw [map_add, smul_add, ha x, hb x, h, LinearMap.map_add φ (x * a + a * x) (x * b + b * x)]
    simp only [LinearMap.add_apply]
  smul_mem' := by
    intro c a ha x
    have harg : x * (c • a) + (c • a) * x = c • (x * a + a * x) := by
      rw [Algebra.mul_smul_comm, Algebra.smul_mul_assoc, smul_add]
    rw [harg, LinearMap.map_smul, LinearMap.map_smul, smul_comm (2 : K) c, ha x,
      LinearMap.smul_apply]

theorem mem_balancedSet {φ : A →ₗ[K] A →ₗ[K] V} {s : A} :
    s ∈ balancedSet φ ↔ ∀ x : A, (2 : K) • φ x s = φ (x * s + s * x) 1 :=
  Iff.rfl

/-- Every idempotent belongs to `S`. -/
theorem idem_mem_balancedSet {φ : A →ₗ[K] A →ₗ[K] V}
    (hφ : ∀ x y : A, x * y + y * x = 0 → φ x y = 0)
    {e : A} (he : e * e = e) : e ∈ balancedSet φ := by
  rw [mem_balancedSet]
  intro x
  rw [two_smul_phi_apply_of_idem hφ he x, LinearMap.map_add φ (x * e) (e * x),
    LinearMap.add_apply]

/-- Bresar's induction step: if `f1 * t`, `e1 * t` and `t * e2` are balanced, then so is
`e1 * t * e2`. -/
theorem balancedSet_mul_idem {φ : A →ₗ[K] A →ₗ[K] V}
    (hφ : ∀ x y : A, x * y + y * x = 0 → φ x y = 0)
    {e₁ e₂ t : A} (he₁ : e₁ * e₁ = e₁) (he₂ : e₂ * e₂ = e₂)
    (ht₂ : t * e₂ ∈ balancedSet φ) (hf₁t : (1 - e₁) * t ∈ balancedSet φ)
    (he₁t : e₁ * t ∈ balancedSet φ) :
    e₁ * t * e₂ ∈ balancedSet φ := by
  rw [mem_balancedSet] at ht₂ hf₁t he₁t ⊢
  intro x
  set f₁ : A := 1 - e₁ with hf₁
  set f₂ : A := 1 - e₂ with hf₂
  have he₁f₁ : e₁ * f₁ = 0 := by rw [hf₁, mul_sub, mul_one, he₁, sub_self]
  have hf₁e₁ : f₁ * e₁ = 0 := by rw [hf₁, sub_mul, one_mul, he₁, sub_self]
  have he₂f₂ : e₂ * f₂ = 0 := by rw [hf₂, mul_sub, mul_one, he₂, sub_self]
  have hf₂e₂ : f₂ * e₂ = 0 := by rw [hf₂, sub_mul, one_mul, he₂, sub_self]
  -- the Peirce pieces of `x`
  set x₁ : A := e₂ * x * e₁ with hx₁
  set x₂ : A := f₂ * x * e₁ with hx₂
  set x₃ : A := e₂ * x * f₁ with hx₃
  set x₄ : A := f₂ * x * f₁ with hx₄
  have hxdec : x = x₁ + x₂ + x₃ + x₄ := by
    rw [hx₁, hx₂, hx₃, hx₄, hf₁, hf₂]
    noncomm_ring
  -- three ways of writing `e1 * t * e2`
  have hw₁ : e₁ * t * e₂ = t * e₂ - f₁ * t + f₁ * t * f₂ := by
    rw [hf₁, hf₂]
    noncomm_ring
  have hw₂ : e₁ * t * e₂ = t * e₂ - f₁ * t * e₂ := by
    rw [hf₁]
    noncomm_ring
  have hw₃ : e₁ * t * e₂ = e₁ * t - e₁ * t * f₂ := by
    rw [hf₂]
    noncomm_ring
  -- the four products that anticommute
  have hv₁ : x₁ * (f₁ * t * f₂) + (f₁ * t * f₂) * x₁ = 0 := by
    have hl : x₁ * (f₁ * t * f₂) = 0 := by
      rw [hx₁]
      simp only [mul_assoc]
      rw [← mul_assoc e₁ f₁ (t * f₂), he₁f₁, zero_mul]
      simp
    have hr : (f₁ * t * f₂) * x₁ = 0 := by
      rw [hx₁]
      simp only [mul_assoc]
      rw [← mul_assoc f₂ e₂ (x * e₁), hf₂e₂, zero_mul]
      simp
    rw [hl, hr, add_zero]
  have hv₂ : x₂ * (f₁ * t * e₂) + (f₁ * t * e₂) * x₂ = 0 := by
    have hl : x₂ * (f₁ * t * e₂) = 0 := by
      rw [hx₂]
      simp only [mul_assoc]
      rw [← mul_assoc e₁ f₁ (t * e₂), he₁f₁, zero_mul]
      simp
    have hr : (f₁ * t * e₂) * x₂ = 0 := by
      rw [hx₂]
      simp only [mul_assoc]
      rw [← mul_assoc e₂ f₂ (x * e₁), he₂f₂, zero_mul]
      simp
    rw [hl, hr, add_zero]
  have hv₃ : x₃ * (e₁ * t * f₂) + (e₁ * t * f₂) * x₃ = 0 := by
    have hl : x₃ * (e₁ * t * f₂) = 0 := by
      rw [hx₃]
      simp only [mul_assoc]
      rw [← mul_assoc f₁ e₁ (t * f₂), hf₁e₁, zero_mul]
      simp
    have hr : (e₁ * t * f₂) * x₃ = 0 := by
      rw [hx₃]
      simp only [mul_assoc]
      rw [← mul_assoc f₂ e₂ (x * f₁), hf₂e₂, zero_mul]
      simp
    rw [hl, hr, add_zero]
  have hv₄ : x₄ * (e₁ * t * e₂) + (e₁ * t * e₂) * x₄ = 0 := by
    have hl : x₄ * (e₁ * t * e₂) = 0 := by
      rw [hx₄]
      simp only [mul_assoc]
      rw [← mul_assoc f₁ e₁ (t * e₂), hf₁e₁, zero_mul]
      simp
    have hr : (e₁ * t * e₂) * x₄ = 0 := by
      rw [hx₄]
      simp only [mul_assoc]
      rw [← mul_assoc e₂ f₂ (x * f₁), he₂f₂, zero_mul]
      simp
    rw [hl, hr, add_zero]
  -- the four contributions
  have hx1 : (2 : K) • φ x₁ (e₁ * t * e₂)
      = φ (x₁ * (t * e₂) + (t * e₂) * x₁) 1
          - φ (x₁ * (f₁ * t) + (f₁ * t) * x₁) 1 := by
    have hzero : φ x₁ (f₁ * t * f₂) = 0 := hφ x₁ (f₁ * t * f₂) hv₁
    rw [hw₁, map_add, map_sub, hzero, add_zero, smul_sub, ht₂ x₁, hf₁t x₁]
  have hx2 : (2 : K) • φ x₂ (e₁ * t * e₂)
      = φ (x₂ * (t * e₂) + (t * e₂) * x₂) 1 := by
    have hzero : φ x₂ (f₁ * t * e₂) = 0 := hφ x₂ (f₁ * t * e₂) hv₂
    rw [hw₂, map_sub, hzero, sub_zero, ht₂ x₂]
  have hx3 : (2 : K) • φ x₃ (e₁ * t * e₂)
      = φ (x₃ * (e₁ * t) + (e₁ * t) * x₃) 1 := by
    have hzero : φ x₃ (e₁ * t * f₂) = 0 := hφ x₃ (e₁ * t * f₂) hv₃
    rw [hw₃, map_sub, hzero, sub_zero, he₁t x₃]
  have hx4 : (2 : K) • φ x₄ (e₁ * t * e₂) = 0 := by
    rw [show φ x₄ (e₁ * t * e₂) = 0 from hφ x₄ (e₁ * t * e₂) hv₄, smul_zero]
  -- the element identity comparing the four contributions with `x * (e1 t e2) + (e1 t e2) * x`
  have hE₁ : x₁ * (e₁ * t * e₂) + (e₁ * t * e₂) * x₁
      = (x₁ * (t * e₂) + (t * e₂) * x₁) - (x₁ * (f₁ * t) + (f₁ * t) * x₁) := by
    rw [hw₁,
      show x₁ * (t * e₂ - f₁ * t + f₁ * t * f₂)
          + (t * e₂ - f₁ * t + f₁ * t * f₂) * x₁
        = (x₁ * (t * e₂) + (t * e₂) * x₁) - (x₁ * (f₁ * t) + (f₁ * t) * x₁)
          + (x₁ * (f₁ * t * f₂) + (f₁ * t * f₂) * x₁) from by noncomm_ring,
      hv₁, add_zero]
  have hE₂ : x₂ * (e₁ * t * e₂) + (e₁ * t * e₂) * x₂
      = x₂ * (t * e₂) + (t * e₂) * x₂ := by
    rw [hw₂,
      show x₂ * (t * e₂ - f₁ * t * e₂) + (t * e₂ - f₁ * t * e₂) * x₂
        = (x₂ * (t * e₂) + (t * e₂) * x₂)
          - (x₂ * (f₁ * t * e₂) + (f₁ * t * e₂) * x₂)
          from by noncomm_ring,
      hv₂, sub_zero]
  have hE₃ : x₃ * (e₁ * t * e₂) + (e₁ * t * e₂) * x₃
      = x₃ * (e₁ * t) + (e₁ * t) * x₃ := by
    rw [hw₃,
      show x₃ * (e₁ * t - e₁ * t * f₂) + (e₁ * t - e₁ * t * f₂) * x₃
        = (x₃ * (e₁ * t) + (e₁ * t) * x₃)
          - (x₃ * (e₁ * t * f₂) + (e₁ * t * f₂) * x₃)
          from by noncomm_ring,
      hv₃, sub_zero]
  have hE₄ : x₄ * (e₁ * t * e₂) + (e₁ * t * e₂) * x₄ = 0 := hv₄
  have hEsum : x * (e₁ * t * e₂) + (e₁ * t * e₂) * x
      = ((x₁ * (t * e₂) + (t * e₂) * x₁) - (x₁ * (f₁ * t) + (f₁ * t) * x₁))
        + (x₂ * (t * e₂) + (t * e₂) * x₂) + (x₃ * (e₁ * t) + (e₁ * t) * x₃) := by
    rw [hxdec,
      show (x₁ + x₂ + x₃ + x₄) * (e₁ * t * e₂)
          + (e₁ * t * e₂) * (x₁ + x₂ + x₃ + x₄)
        = (x₁ * (e₁ * t * e₂) + (e₁ * t * e₂) * x₁)
            + (x₂ * (e₁ * t * e₂) + (e₁ * t * e₂) * x₂)
            + (x₃ * (e₁ * t * e₂) + (e₁ * t * e₂) * x₃)
            + (x₄ * (e₁ * t * e₂) + (e₁ * t * e₂) * x₄)
        from by noncomm_ring,
      hE₁, hE₂, hE₃, hE₄]
    abel
  calc (2 : K) • φ x (e₁ * t * e₂)
      = (2 : K) • (φ x₁ (e₁ * t * e₂) + φ x₂ (e₁ * t * e₂)
          + φ x₃ (e₁ * t * e₂) + φ x₄ (e₁ * t * e₂)) := by
        rw [hxdec, map_add, LinearMap.add_apply, map_add, LinearMap.add_apply, map_add,
          LinearMap.add_apply]
    _ = (2 : K) • φ x₁ (e₁ * t * e₂) + (2 : K) • φ x₂ (e₁ * t * e₂)
          + (2 : K) • φ x₃ (e₁ * t * e₂) + (2 : K) • φ x₄ (e₁ * t * e₂) := by
        rw [smul_add, smul_add, smul_add]
    _ = (φ (x₁ * (t * e₂) + (t * e₂) * x₁) 1
          - φ (x₁ * (f₁ * t) + (f₁ * t) * x₁) 1)
          + φ (x₂ * (t * e₂) + (t * e₂) * x₂) 1
          + φ (x₃ * (e₁ * t) + (e₁ * t) * x₃) 1 + 0 := by
        rw [hx1, hx2, hx3, hx4]
    _ = φ (x * (e₁ * t * e₂) + (e₁ * t * e₂) * x) 1 := by
        rw [hEsum]
        simp only [map_add, map_sub, LinearMap.add_apply, LinearMap.sub_apply, add_zero]



/-- Every product of idempotents is balanced. -/
theorem prod_mem_balancedSet {φ : A →ₗ[K] A →ₗ[K] V}
    (hφ : ∀ x y : A, x * y + y * x = 0 → φ x y = 0) :
    ∀ (n : ℕ) (l : List A), l.length = n → (∀ e ∈ l, e * e = e) →
      l.prod ∈ balancedSet φ
  | 0, l, hl, _ => by
    have hl' : l = [] := by
      cases l with
      | nil => rfl
      | cons a as => simp at hl
    subst hl'
    rw [List.prod_nil]
    exact idem_mem_balancedSet hφ (by simp)
  | n + 1, l, hl, hidem => by
    cases l with
    | nil => simp at hl
    | cons e₁ l' =>
      simp only [List.length_cons] at hl
      rcases List.eq_nil_or_concat l' with hl' | ⟨m, e₂, hl'⟩
      · subst hl'
        simpa using idem_mem_balancedSet hφ (hidem e₁ (by simp))
      · subst hl'
        have hm_len : m.length + 1 = n := by simpa using hl
        have he₁ : e₁ * e₁ = e₁ := hidem e₁ (by simp)
        have he₂ : e₂ * e₂ = e₂ := hidem e₂ (by simp)
        have hf₁idem : (1 - e₁) * (1 - e₁) = 1 - e₁ :=
          isIdempotentElem_iff.mp (isIdempotentElem_iff.mpr he₁).one_sub
        have ht : m.prod * e₂ ∈ balancedSet φ := by
          have h := prod_mem_balancedSet hφ n (m ++ [e₂]) (by simpa using hl)
            (fun e he => hidem e (by simp [he]))
          simpa [List.prod_append] using h
        have hf₁t : (1 - e₁) * m.prod ∈ balancedSet φ := by
          have h := prod_mem_balancedSet hφ n ((1 - e₁) :: m) (by simp [hm_len])
            (fun e he => by
              rcases List.mem_cons.mp he with h' | h'
              · subst h'
                exact hf₁idem
              · exact hidem e (by simp [h']))
          simpa using h
        have he₁t : e₁ * m.prod ∈ balancedSet φ := by
          have h := prod_mem_balancedSet hφ n (e₁ :: m) (by simp [hm_len])
            (fun e he => by
              rcases List.mem_cons.mp he with h' | h'
              · subst h'
                exact he₁
              · exact hidem e (by simp [h']))
          simpa using h
        have hstep := balancedSet_mul_idem hφ he₁ he₂ ht hf₁t he₁t
        simpa [List.prod_cons, List.prod_append, mul_assoc] using hstep

/-! ## The span of the products of idempotents -/

/-- The `K`-span of the products of idempotents of `A`. Its being a subalgebra is what makes
generation by idempotents usable: the products are not spanned by the idempotents themselves. -/
noncomputable def idemProdSpan : Submodule K A :=
  Submodule.span K {x : A | ∃ l : List A, (∀ e ∈ l, e * e = e) ∧ x = l.prod}

theorem subset_idemProdSpan {x : A} (hx : x * x = x) :
    x ∈ idemProdSpan (K := K) (A := A) :=
  Submodule.subset_span
    ⟨[x], fun e he => by simpa using (List.mem_singleton.mp he) ▸ hx, by simp⟩

theorem one_mem_idemProdSpan : (1 : A) ∈ idemProdSpan (K := K) (A := A) :=
  Submodule.subset_span ⟨[], by simp, by simp⟩

theorem mul_mem_idemProdSpan {x y : A} (hx : x ∈ idemProdSpan (K := K) (A := A))
    (hy : y ∈ idemProdSpan (K := K) (A := A)) :
    x * y ∈ idemProdSpan (K := K) (A := A) := by
  rw [idemProdSpan] at hx hy ⊢
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, hl, rfl⟩ := hx
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨l', hl', rfl⟩ := hy
      refine Submodule.subset_span ⟨l ++ l', fun e he => ?_, List.prod_append.symm⟩
      rcases List.mem_append.mp he with h | h
      · exact hl e h
      · exact hl' e h
    | zero => simp
    | add y z _ _ ihy ihz => rw [mul_add]; exact Submodule.add_mem _ ihy ihz
    | smul c y _ ihy => rw [Algebra.mul_smul_comm]; exact Submodule.smul_mem _ c ihy
  | zero => simp
  | add x y _ _ ihx ihy => rw [add_mul]; exact Submodule.add_mem _ ihx ihy
  | smul c x _ ihx => rw [Algebra.smul_mul_assoc]; exact Submodule.smul_mem _ c ihx

/-- The subalgebra spanned by the products of idempotents. -/
noncomputable def idemProdSubalgebra : Subalgebra K A where
  carrier := idemProdSpan (K := K) (A := A)
  one_mem' := one_mem_idemProdSpan
  mul_mem' := mul_mem_idemProdSpan
  add_mem' := fun hx hy => Submodule.add_mem _ hx hy
  zero_mem' := Submodule.zero_mem _
  algebraMap_mem' := fun r => by
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ r one_mem_idemProdSpan

theorem adjoin_le_idemProdSubalgebra :
    Algebra.adjoin K {e : A | e * e = e} ≤ idemProdSubalgebra (K := K) (A := A) := by
  rw [Algebra.adjoin_le_iff]
  intro e he
  exact subset_idemProdSpan he

theorem adjoin_subset_idemProdSpan :
    (Algebra.adjoin K {e : A | e * e = e} : Set A) ⊆ idemProdSpan (K := K) (A := A) :=
  fun _x hx => adjoin_le_idemProdSubalgebra hx

theorem idemProdSpan_le_balancedSet {φ : A →ₗ[K] A →ₗ[K] V}
    (hφ : ∀ x y : A, x * y + y * x = 0 → φ x y = 0) :
    idemProdSpan (K := K) (A := A) ≤ balancedSet φ := by
  rw [idemProdSpan, Submodule.span_le]
  rintro x ⟨l, hl, rfl⟩
  exact prod_mem_balancedSet hφ l.length l rfl hl

/-- The subalgebra generated by the idempotents is contained in Bresar's `S`. -/
theorem adjoin_subset_balancedSet {φ : A →ₗ[K] A →ₗ[K] V}
    (hφ : ∀ x y : A, x * y + y * x = 0 → φ x y = 0) :
    (Algebra.adjoin K {e : A | e * e = e} : Set A) ⊆ balancedSet φ :=
  fun _x hx => idemProdSpan_le_balancedSet hφ (adjoin_subset_idemProdSpan hx)

theorem adjoin_eq_top_of_span_eq_top {s : Set A} (h : Submodule.span K s = ⊤) :
    Algebra.adjoin K s = ⊤ := by
  rw [eq_top_iff]
  intro x _
  have hx : x ∈ Submodule.span K s := by rw [h]; exact Submodule.mem_top
  have hle : Submodule.span K s ≤ (Algebra.adjoin K s).toSubmodule :=
    Submodule.span_le.mpr (fun y hy => Algebra.subset_adjoin hy)
  exact hle hx

/-- **Bresar's Theorem 3.15**, the hypothesis the paper's `rem:inner` uses: a unital algebra
over a field with `2 ≠ 0` that is generated by its idempotents is determined by its symmetrised
product `x * y + y * x`. -/
theorem determined_twistMu_of_generated (h2 : (2 : K) ≠ 0)
    (hA : Algebra.adjoin K {e : A | e * e = e} = ⊤) :
    Determined (twistMu (LinearMap.id : A →ₗ[K] A)) := by
  intro V _ _ φ hφ
  have hmem : ∀ b : A, b ∈ balancedSet φ := fun b =>
    adjoin_subset_balancedSet (φ := φ) hφ (by rw [hA]; trivial)
  refine ⟨(2 : K)⁻¹ • φ.flip 1, fun a b => ?_⟩
  have key := hmem b a
  show φ a b = ((2 : K)⁻¹ • φ.flip 1) (twistMu (LinearMap.id : A →ₗ[K] A) a b)
  simp only [twistMu_apply, LinearMap.id_apply, LinearMap.smul_apply, map_add,
    LinearMap.flip_apply]
  rw [← smul_add, ← LinearMap.add_apply, ← map_add, ← key, smul_smul, inv_mul_cancel₀ h2,
    one_smul]

/-- **Ghahramani's Theorem 3.3: the span hypothesis.** A unital algebra over a field with `2 ≠ 0`
whose idempotents span it linearly is determined by its symmetrised product `x * y + y * x`. It is
the special case of `determined_twistMu_of_generated` in which the hypothesis is linear spanning
rather than generation, and the two are not equivalent (see the file docstring). Ghahramani proves
it over `ℂ`; the proof uses only that `2 ≠ 0`. -/
theorem determined_twistMu_id (h2 : (2 : K) ≠ 0)
    (hA : Submodule.span K {e : A | e * e = e} = ⊤) :
    Determined (twistMu (LinearMap.id : A →ₗ[K] A)) :=
  determined_twistMu_of_generated h2 (adjoin_eq_top_of_span_eq_top hA)

end Core

/-! ## The algebra `M₂(K)` is spanned by its idempotents -/

section Matrix2

variable (K : Type u) [Field K]

/-- The matrix unit `e₁₁`. -/
def m00 : Matrix (Fin 2) (Fin 2) K := !![1, 0; 0, 0]

/-- The matrix unit `e₂₂`. -/
def m11 : Matrix (Fin 2) (Fin 2) K := !![0, 0; 0, 1]

/-- The matrix unit `e₁₂`. -/
def m01 : Matrix (Fin 2) (Fin 2) K := !![0, 1; 0, 0]

/-- The matrix unit `e₂₁`. -/
def m10 : Matrix (Fin 2) (Fin 2) K := !![0, 0; 1, 0]

/-- The idempotent `e₁₁ + e₁₂`. -/
def p01 : Matrix (Fin 2) (Fin 2) K := !![1, 1; 0, 0]

/-- The idempotent `e₁₁ + e₂₁`. -/
def p10 : Matrix (Fin 2) (Fin 2) K := !![1, 0; 1, 0]

theorem idem_m00 : m00 K * m00 K = m00 K := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [m00, Matrix.mul_apply, Fin.sum_univ_two]

theorem idem_m11 : m11 K * m11 K = m11 K := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [m11, Matrix.mul_apply, Fin.sum_univ_two]

theorem idem_p01 : p01 K * p01 K = p01 K := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [p01, Matrix.mul_apply, Fin.sum_univ_two]

theorem idem_p10 : p10 K * p10 K = p10 K := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [p10, Matrix.mul_apply, Fin.sum_univ_two]

theorem m01_eq : m01 K = p01 K - m00 K := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [m01, p01, m00, Matrix.sub_apply]

theorem m10_eq : m10 K = p10 K - m00 K := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [m10, p10, m00, Matrix.sub_apply]

/-- **`M₂(K)` is spanned by its idempotents**, for every field `K`. -/
theorem span_idempotents_eq_top :
    Submodule.span K {e : Matrix (Fin 2) (Fin 2) K | e * e = e} = ⊤ := by
  have h00 : m00 K ∈ Submodule.span K {e : Matrix (Fin 2) (Fin 2) K | e * e = e} :=
    Submodule.subset_span (idem_m00 K)
  have h11 : m11 K ∈ Submodule.span K {e : Matrix (Fin 2) (Fin 2) K | e * e = e} :=
    Submodule.subset_span (idem_m11 K)
  have h01 : m01 K ∈ Submodule.span K {e : Matrix (Fin 2) (Fin 2) K | e * e = e} := by
    rw [m01_eq]
    exact Submodule.sub_mem _ (Submodule.subset_span (idem_p01 K)) h00
  have h10 : m10 K ∈ Submodule.span K {e : Matrix (Fin 2) (Fin 2) K | e * e = e} := by
    rw [m10_eq]
    exact Submodule.sub_mem _ (Submodule.subset_span (idem_p10 K)) h00
  rw [eq_top_iff]
  intro M _
  have hM : M = M 0 0 • m00 K + M 0 1 • m01 K + M 1 0 • m10 K + M 1 1 • m11 K := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [m00, m01, m10, m11, Matrix.add_apply]
  rw [hM]
  exact Submodule.add_mem _ (Submodule.add_mem _ (Submodule.add_mem _
    (Submodule.smul_mem _ _ h00) (Submodule.smul_mem _ _ h01))
    (Submodule.smul_mem _ _ h10)) (Submodule.smul_mem _ _ h11)

/-- `M₂(K)` is determined by its symmetrised product, in characteristic `≠ 2`. -/
theorem determined_twistMu_id_matrix (h2 : (2 : K) ≠ 0) :
    Determined (twistMu (LinearMap.id :
      Matrix (Fin 2) (Fin 2) K →ₗ[K] Matrix (Fin 2) (Fin 2) K)) :=
  determined_twistMu_id h2 (span_idempotents_eq_top K)

/-- **`rem:inner` for `M₂(K)`**: the twisted product of the conjugation by **any** unit `D`
determines the algebra, in characteristic `≠ 2`. -/
theorem determined_twistMu_conjByUnit (h2 : (2 : K) ≠ 0) (D : (Matrix (Fin 2) (Fin 2) K)ˣ) :
    Determined (twistMu (BraidedSymZpd.conjByUnit (K := K) D)) :=
  (BraidedSymZpd.determined_twist_conj_iff (K := K) D).mpr
    (determined_twistMu_id_matrix K h2)

end Matrix2

/-! ## `prop:matrix`: the case `M₂(𝔽₃)` and `α = conj (diag (1, -1))` -/

/-- The unit `diag (1, -1)` of `M₂(𝔽₃)`. -/
def diagUnit : (Matrix (Fin 2) (Fin 2) (ZMod 3))ˣ where
  val := !![1, 0; 0, -1]
  inv := !![1, 0; 0, -1]
  val_inv := by decide
  inv_val := by decide

/-- The conjugation by `diag (1, -1)`, written out. -/
theorem conjByUnit_diagUnit_apply (x : Matrix (Fin 2) (Fin 2) (ZMod 3)) :
    BraidedSymZpd.conjByUnit (K := ZMod 3) diagUnit x
      = !![1, 0; 0, -1] * x * !![1, 0; 0, -1] := rfl

/-- **`prop:matrix`**: `M₂(𝔽₃)` is determined by the twisted product
`x * y + α (y * x)` of the conjugation `α` by `diag (1, -1)`. -/
theorem determined_matrix2 :
    Determined (twistMu (BraidedSymZpd.conjByUnit (K := ZMod 3) diagUnit)) :=
  determined_twistMu_conjByUnit (ZMod 3) (by decide) diagUnit

/-! ## The paper's `μ_α (x, y) = x * y + α (y * x)` for a multiplicative inner twist -/

section ConjFormula

variable {K : Type u} [Field K]
variable {R : Type u} [Ring R] [Algebra K R]

/-- For a multiplicative `α = conj D`, the symmetrised twisted product is the paper's
`μ_α (x, y) = x * y + α (y * x)`. -/
theorem twistMu_conjByUnit_apply (D : Rˣ) (x y : R) :
    twistMu (BraidedSymZpd.conjByUnit (K := K) D) x y
      = x * y + BraidedSymZpd.conjByUnit (K := K) D (y * x) := by
  rw [twistMu_apply, ← BraidedSymZpd.conjByUnit_mul]

end ConjFormula

/-! ## The paper's `μ_σ` for the swap braiding -/

section Symm

variable {K : Type u} [Field K]
variable {A : Type u} [Ring A] [Algebra K A]

/-- The paper's `μ_σ` for the swap braiding `σ (x ⊗ y) = y ⊗ x` is the symmetrised product:
on a pure tensor `μ_σ (x, y) = m (x ⊗ y + σ (x ⊗ y)) = x * y + y * x`, i.e. `twistMu id`. -/
theorem twistMu_id_tmul_add_swap (x y : A) :
    twistMu (LinearMap.id : A →ₗ[K] A) x y
      = LinearMap.mul' K A (x ⊗ₜ[K] y)
          + LinearMap.mul' K A (y ⊗ₜ[K] x) := by
  simp only [twistMu_apply, LinearMap.id_apply, LinearMap.mul'_apply]

end Symm

